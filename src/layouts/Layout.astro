		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<main>
			<nav>
				<a href="/">Index</a>
				<a href="/llm-json-stream">LLM JSON</a>
				<a href="/project-2359">2359</a>
				<a href="/project-2360">2360</a>
			</nav>
			<slot />
		</main>
	</body>
</html>
