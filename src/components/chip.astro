---
import { Icon } from 'astro-icon/components';

interface Props {
  label: string;
  href?: string;
  linkText?: string;
}

const { label, href, linkText } = Astro.props;
const hasIcon = Astro.slots.has('icon');
const isLink = !!href;
---

{isLink ? (
  <a href={href} class="chip link-chip" target="_blank" rel="noopener noreferrer">
    {hasIcon && (
      <div class="icon-slot">
        <slot name="icon" />
      </div>
    )}
    <div class="label-group">
      <span class="label">{label}</span>
      {linkText && (
        <span class="link-display">
          {linkText}
          <Icon name="tabler:external-link" class="external-icon" />
        </span>
      )}
    </div>
  </a>
) : (
  <div class="chip">
    {hasIcon && (
      <div class="icon-slot">
        <slot name="icon" />
      </div>
    )}
    <span class="label">{label}</span>
  </div>
)}

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 0; /* Pure square for grid snapping */
    font-size: 0.8rem;
    font-weight: 500;
    color: #374151;
    position: relative;
    box-shadow: 2px 2px 0px rgba(0, 0, 0, 0.05); /* Blocky shadow */
    text-decoration: none;
    
    /* Weathering effect */
    background-image: 
      url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E");
    
    justify-content: center;
    transition: 
      transform 150ms var(--ease-out-expo),
      box-shadow 150ms var(--ease-out-expo),
      border-color 150ms var(--ease-out-expo);
    cursor: default;
    user-select: none;
  }

  .chip:active {
    transform: scale(0.97);
  }

  .link-chip {
    cursor: pointer;
  }

  /* Blueprint Corner Markers */
  .chip::before, .chip::after {
    content: "";
    position: absolute;
    width: 6px;
    height: 6px;
    border-color: var(--grid-color);
    border-style: solid;
    pointer-events: none;
    opacity: 0.8;
  }

  /* Top-left marker */
  .chip::before {
    top: -3px;
    left: -3px;
    border-width: 1px 0 0 1px;
  }

  /* Bottom-right marker */
  .chip::after {
    bottom: -3px;
    right: -3px;
    border-width: 0 1px 1px 0;
  }

  .chip:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px var(--grid-color);
    border-color: var(--text-color);
  }

  .label-group {
    display: flex;
    align-items: center;
    gap: 1.5rem; /* Increased spacing as requested */
  }

  .link-display {
    font-weight: 400;
    opacity: 0.6;
    text-decoration: underline;
    text-underline-offset: 2px;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .external-icon {
    width: 0.9rem;
    height: 0.9rem;
    opacity: 0.8;
  }

  .icon-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
  }

  .icon-slot :global(svg) {
    width: 100%;
    height: 100%;
  }

  .label {
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .chip {
      background-color: transparent !important;
      background-image: none !important;
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      font-size: 0.85rem !important;
      gap: 0.35rem !important;
    }

    .chip::before,
    .chip::after {
      display: none !important;
    }

    .chip:hover {
      transform: none !important;
      box-shadow: none !important;
      border-color: transparent !important;
    }
  }
</style>

