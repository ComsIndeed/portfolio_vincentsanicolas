---
import { Icon } from 'astro-icon/components';

interface TabItem {
  id: string;
  label: string;
  icon?: string;
}

interface Props {
  items: TabItem[];
  defaultActive?: string;
}

const { items, defaultActive } = Astro.props;

// Pre-render all slots to HTML strings in the frontmatter since JSX map callbacks must be synchronous.
const renderedPanes = await Promise.all(
  items.map(async (item) => {
    const html = Astro.slots.has(item.id)
      ? await Astro.slots.render(item.id)
      : '';
    return { id: item.id, html };
  })
);
---

<div class="tabs-container">
  <!-- Tab buttons -->
  <div class="tabs-header">
    {items.map((item, index) => (
      <button 
        class={`tab-button ${index === 0 ? 'active' : ''}`}
        data-tab-target={item.id}
        type="button"
      >
        {item.icon && <Icon name={item.icon} class="tab-icon" />}
        <span class="tab-label">{item.label}</span>
        
        {/* Technical Blueprint Corner Marks */}
        <div class="tab-corner-tl"></div>
        <div class="tab-corner-br"></div>
      </button>
    ))}
  </div>

  <!-- Content Box with weathered borders -->
  <div class="weathered-content-box">
    <!-- The Weathered SVG Borders -->
    <div class="weathered-borders" aria-hidden="true" style="color: var(--text-color);">
      <svg class="borders-svg" width="100%" height="100%" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- Fractal noise filter using userSpaceOnUse to prevent zero-height/zero-width clipping -->
          <filter id="ink-bleed" filterUnits="userSpaceOnUse" x="-10%" y="-10%" width="120%" height="120%">
            <feTurbulence type="fractalNoise" baseFrequency="0.5" numOctaves="3" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G" />
          </filter>
          
          <!-- Top Border: Solid for first 60%, fades quicker so it is fully gone by 90% -->
          <linearGradient id="top-ink-fade" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="currentColor" stop-opacity="0.3" />
            <stop offset="60%" stop-color="currentColor" stop-opacity="0.3" />
            <stop offset="75%" stop-color="currentColor" stop-opacity="0.1" />
            <stop offset="90%" stop-color="currentColor" stop-opacity="0" />
          </linearGradient>
          
          <!-- Vertical Borders: Fades down over 320px (5 grid units) to absolute transparency -->
          <linearGradient id="vertical-ink-fade" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="currentColor" stop-opacity="0.3" />
            <stop offset="25%" stop-color="currentColor" stop-opacity="0.2" />
            <stop offset="65%" stop-color="currentColor" stop-opacity="0.08" />
            <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
          </linearGradient>
        </defs>
        
        {/* Top Border: Drawn as thin rect (1.5px height) to ensure non-zero bounding box */}
        <rect 
          x="0" 
          y="0" 
          width="100%" 
          height="1.5" 
          fill="url(#top-ink-fade)" 
          filter="url(#ink-bleed)" 
        />
        
        {/* Left Border: Drawn as thin rect (1.5px width) to ensure non-zero bounding box */}
        <rect 
          x="0" 
          y="0" 
          width="1.5" 
          height="320" 
          fill="url(#vertical-ink-fade)" 
          filter="url(#ink-bleed)" 
        />
      </svg>
    </div>

    <!-- Active Tab Pane Render Slot -->
    <div class="tabs-panes-wrapper">
      {renderedPanes.map((pane, index) => (
        <div 
          class={`tab-pane ${index === 0 ? 'active' : ''}`}
          data-tab-pane={pane.id}
          set:html={pane.html}
        />
      ))}
    </div>
  </div>
</div>

<style>
  .tabs-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    position: relative;
    margin-top: 1rem;
  }

  /* Tab Header styling */
  .tabs-header {
    display: flex;
    gap: 0.75rem;
    position: relative;
    z-index: 15; /* Sits above content borders */
    flex-wrap: wrap;
    padding-left: 1px; /* Align perfectly with left border line */
  }

  /* Core Tab Button styling - resembling a premium, larger custom chip */
  .tab-button {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 1.25rem;
    background-color: var(--bg-color);
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 0; /* Blueprint strict square corners */
    font-size: 0.9rem;
    font-weight: 500;
    color: #4b5563;
    font-family: 'JetBrains Mono', monospace;
    position: relative;
    cursor: pointer;
    user-select: none;
    transition: 
      transform 150ms var(--ease-out-expo),
      box-shadow 150ms var(--ease-out-expo),
      border-color 150ms var(--ease-out-expo),
      background-color 150ms var(--ease-out-expo),
      color 150ms var(--ease-out-expo);
    
    /* Subtle draftsman weathering noise pattern background */
    background-image: 
      url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
  }

  /* Blueprint Corner Markers for inactive tab button (subtle opacity) */
  .tab-corner-tl, .tab-corner-br {
    content: "";
    position: absolute;
    width: 6px;
    height: 6px;
    border-color: var(--grid-color);
    border-style: solid;
    pointer-events: none;
    opacity: 0.4;
    transition: opacity 150ms var(--ease-out-expo), transform 150ms var(--ease-out-expo);
  }

  .tab-corner-tl {
    top: -3px;
    left: -3px;
    border-width: 1px 0 0 1px;
  }

  .tab-corner-br {
    bottom: -3px;
    right: -3px;
    border-width: 0 1px 1px 0;
  }

  /* Hover micro-interactions */
  .tab-button:hover {
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0px var(--grid-color);
    border-color: var(--text-color);
    color: var(--text-color);
    background-color: rgba(0, 0, 0, 0.02);
  }

  .tab-button:hover .tab-corner-tl {
    opacity: 0.8;
    transform: translate(-1px, -1px);
  }

  .tab-button:hover .tab-corner-br {
    opacity: 0.8;
    transform: translate(1px, 1px);
  }

  /* Active state */
  .tab-button.active {
    background-color: var(--bg-color);
    border-color: var(--text-color);
    border-width: 1.5px;
    color: var(--text-color);
    font-weight: 600;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px var(--text-color);
    z-index: 20;
  }

  .tab-button.active .tab-corner-tl {
    opacity: 1;
    border-color: var(--text-color);
    transform: translate(-2px, -2px);
  }

  .tab-button.active .tab-corner-br {
    opacity: 1;
    border-color: var(--text-color);
    transform: translate(2px, 2px);
  }

  .tab-button:active {
    transform: scale(0.97);
  }

  /* The Content Box holding slots */
  .weathered-content-box {
    position: relative;
    width: 100%;
    margin-top: -1px; /* Align and overlay with tabs */
    z-index: 10;
  }

  /* SVG borders overlay wrapper */
  .weathered-borders {
    position: absolute;
    top: 1.25rem; /* Shift downwards so it doesn't touch the buttons */
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(100% - 1.25rem);
    pointer-events: none;
    z-index: 12;
  }

  .borders-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* Inner slots wrapper */
  .tabs-panes-wrapper {
    position: relative;
    width: 100%;
    padding: 2.5rem;
    box-sizing: border-box;
    z-index: 11;
  }

  /* Individual Tab Panes styling */
  .tab-pane {
    display: none;
    opacity: 0;
    transform: translateY(4px);
    transition: 
      opacity 200ms var(--ease-out-expo),
      transform 200ms var(--ease-out-expo);
  }

  .tab-pane.active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  /* Tab Icons and Labels styling */
  .tab-icon {
    width: 1.15rem;
    height: 1.15rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
  }

  .tab-label {
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  /* Responsive styling for Mobile */
  @media (max-width: 768px) {
    .tabs-header {
      gap: 0.5rem;
      padding-left: 0;
    }

    .tab-button {
      padding: 0.45rem 0.85rem;
      font-size: 0.8rem;
      gap: 0.45rem;
    }

    .tabs-panes-wrapper {
      padding: 1.5rem;
    }
  }
</style>

<script>
  function initTabs() {
    const containers = document.querySelectorAll('.tabs-container');
    
    containers.forEach((container) => {
      const buttons = container.querySelectorAll('.tab-button');
      const panes = container.querySelectorAll('.tab-pane');
      
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const targetId = button.getAttribute('data-tab-target');
          if (!targetId) return;
          
          // Reset all tabs & panes in this container
          buttons.forEach(btn => btn.classList.remove('active'));
          panes.forEach(pane => pane.classList.remove('active'));
          
          // Set active states
          button.classList.add('active');
          const targetPane = container.querySelector(`[data-tab-pane="${targetId}"]`);
          if (targetPane) {
            targetPane.classList.add('active');
          }
          
          // Re-trigger visual alignment to ensure smart snapping continues to work flawlessly
          window.dispatchEvent(new Event('resize'));
        });
      });
    });
  }

  // Bind to lifecycle events (essential for Astro router navigations)
  document.addEventListener('astro:page-load', initTabs);
</script>
