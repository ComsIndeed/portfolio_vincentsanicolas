---
import Chip from './chip.astro';
import SocialChip from './SocialChip.astro';
import { Icon } from 'astro-icon/components';
---

<div data-snap="block" class="show-snap header-block" data-snap-align="fill">
	<div class="header-container">
		<div class="header-text">
			<div class="name-social-row">
				<h1>Vincent Sanicolas</h1>
				<div class="social-links">
					<SocialChip 
						href="https://github.com/ComsIndeed" 
						icon="simple-icons:github" 
						label="GitHub" 
						iconOnly={true}
					/>
					<SocialChip 
						href="https://www.linkedin.com/in/vincent-sanicolas-2331713a0/" 
						icon="simple-icons:linkedin" 
						label="LinkedIn" 
						iconOnly={true}
					/>
					<SocialChip 
						href="mailto:trulysanicolas@gmail.com" 
						icon="tabler:mail" 
						label="Email" 
						iconOnly={true}
					/>
				</div>
			</div>
			
			<p class="bio-subtitle">
				Software Developer | Flutter & Web
				<br/>
				Metro Manila, Philippines
			</p>

			<div class="stack-list">
				<Chip label="Flutter">
					<Icon name="simple-icons:flutter" slot="icon" />
				</Chip>
				<Chip label="Dart">
					<Icon name="simple-icons:dart" slot="icon" />
				</Chip>
				<Chip label="React">
					<Icon name="simple-icons:react" slot="icon" />
				</Chip>
				<Chip label="TypeScript">
					<Icon name="simple-icons:typescript" slot="icon" />
				</Chip>
				<Chip label="Astro">
					<Icon name="simple-icons:astro" slot="icon" />
				</Chip>
				<Chip label="Supabase">
					<Icon name="simple-icons:supabase" slot="icon" />
				</Chip>
			</div>
		</div>
	</div>
</div>

<style>
	.header-container {
		width: 100%;
	}

	.name-social-row {
		display: flex;
		align-items: center;
		gap: 2.5rem; /* Extra spacing beforehand */
		flex-wrap: wrap;
		margin-bottom: 0.75rem;
	}

	.name-social-row h1 {
		font-size: 2.25rem;
		font-weight: 700;
		letter-spacing: -0.04em;
		margin: 0 !important;
	}

	.social-links {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		justify-content: flex-start; /* Aligned to the left */
	}

	.bio-subtitle {
		font-size: 1rem;
		line-height: 1.5;
		opacity: 0.7;
		margin-bottom: 1.5rem !important; /* Space above stack list */
	}

	.stack-list {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem; /* --sub-grid is 1rem */
		margin-top: 1.5rem;
	}

	/* Force the header block to be full width like project blocks */
	.header-block {
		width: 100% !important;
	}

	@media (max-width: 768px) {
		.name-social-row {
			flex-direction: column-reverse;
			align-items: flex-start;
			gap: 0.75rem;
		}

		.stack-list {
			gap: 0.75rem 1.25rem;
			margin-top: 1.25rem;
		}
	}
</style>
