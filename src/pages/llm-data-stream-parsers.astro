<script>
	function initLanguageSwitchers() {
		const switchers = document.querySelectorAll('.lang-switcher');
		switchers.forEach((switcher) => {
			const buttons = switcher.querySelectorAll('.switcher-btn');
			const panes = switcher.querySelectorAll('.switcher-pane');
			
			buttons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const lang = btn.getAttribute('data-lang');
					if (!lang) return;
					
					buttons.forEach(b => b.classList.remove('active'));
					panes.forEach(p => p.classList.remove('active'));
					
					btn.classList.add('active');
					const activePane = switcher.querySelector(`[data-lang-pane="${lang}"]`);
					if (activePane) {
						activePane.classList.add('active');
					}
					
					// Re-trigger visual grid snapping calculation
					window.dispatchEvent(new Event('resize'));
				});
			});
		});
	}

	document.addEventListener('astro:page-load', initLanguageSwitchers);
</script>
