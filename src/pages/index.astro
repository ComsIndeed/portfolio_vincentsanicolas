---
import Layout from '../layouts/Layout.astro';
import Chip from '../components/chip.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Vincent Sanicolas | Portfolio">
	<div data-snap="block" class="show-snap">
		<h1>Vincent Sanicolas</h1>
	</div>

	<div data-snap="block" class="show-snap">
		<p>
			Software Developer | Flutter & Web
			<br/>
			Metro Manila, Philippines
		</p>
	</div>

	<div data-snap="block" class="show-snap">
		<div class="stack-list">
			<Chip label="Flutter">
				<Icon name="simple-icons:flutter" slot="icon" />
			</Chip>
			<Chip label="Dart">
				<Icon name="simple-icons:dart" slot="icon" />
			</Chip>
			<Chip label="React">
				<Icon name="simple-icons:react" slot="icon" />
			</Chip>
			<Chip label="TypeScript">
				<Icon name="simple-icons:typescript" slot="icon" />
			</Chip>
			<Chip label="Astro">
				<Icon name="simple-icons:astro" slot="icon" />
			</Chip>
			<Chip label="Supabase">
				<Icon name="simple-icons:supabase" slot="icon" />
			</Chip>
		</div>
	</div>
	</div>

	<div data-snap="block" class="show-snap">
		<h2>Projects</h2>
	</div>

	<div class="project-list">
		<!-- Project 1 -->
		<a href="/llm-json-stream" class="project-link">
			<section class="project-group">
				<div data-snap="block" class="show-snap project-header-block">
					<span class="project-name">llm_json_stream (npm & pub.dev)</span>
					<h3 class="project-title">Open-Source Reactive JSON Stream Parser</h3>
				</div>
				<div data-snap="block" class="show-snap project-description-block">
					<p class="project-description">
						A published package for the TypeScript and Dart ecosystems designed to handle and parse complex data streams. Designed for high-performance applications where data scannability and value proposition are paramount.
					</p>
				</div>
				<div data-snap="block" class="show-snap project-tech-block">
					<div class="project-tech">
						<Chip 
							label="TypeScript" 
							href="https://www.npmjs.com/package/llm-json-stream" 
							linkText="Available on NPM"
						>
							<Icon name="simple-icons:typescript" slot="icon" />
						</Chip>
						<Chip 
							label="Dart" 
							href="https://pub.dev/packages/llm_json_stream" 
							linkText="Available on pub.dev"
						>
							<Icon name="simple-icons:dart" slot="icon" />
						</Chip>
					</div>
				</div>
			</section>
		</a>

		<!-- Project 2 -->
		<a href="/project-2359" class="project-link">
			<section class="project-group">
				<div data-snap="block" class="show-snap project-header-block">
					<span class="project-name">Project 2359</span>
					<h3 class="project-title">AI-Driven Study Application & FSRS Scheduler</h3>
				</div>
				<div data-snap="block" class="show-snap project-description-block">
					<p class="project-description">
						A full-stack student application integrating a Free Spaced Repetition Scheduler, PDF indexing, and dynamic study material generation. Built with a strict focus on fluid aesthetic experience and architectural complexity.
					</p>
				</div>
				<div data-snap="block" class="show-snap project-tech-block">
					<div class="project-tech">
						<Chip label="Flutter">
							<Icon name="simple-icons:flutter" slot="icon" />
						</Chip>
						<Chip label="Supabase">
							<Icon name="simple-icons:supabase" slot="icon" />
						</Chip>
						<Chip label="PostgreSQL">
							<Icon name="simple-icons:postgresql" slot="icon" />
						</Chip>
					</div>
				</div>
			</section>
		</a>

		<!-- Project 3 -->
		<a href="/project-2360" class="project-link">
			<section class="project-group">
				<div data-snap="block" class="show-snap project-header-block">
					<span class="project-name">Project 2360 (Flowserract)</span>
					<h3 class="project-title">Modular Flow-Based Architectural Framework</h3>
				</div>
				<div data-snap="block" class="show-snap project-description-block">
					<p class="project-description">
						A conceptual exploration of modular flow-based systems designed to bridge the gap between high-level logic and low-level implementation details. Focusing on visual logic flow and rapid prototyping.
					</p>
				</div>
				<div data-snap="block" class="show-snap project-tech-block">
					<div class="project-tech">
						<Chip label="React">
							<Icon name="simple-icons:react" slot="icon" />
						</Chip>
						<Chip label="TypeScript">
							<Icon name="simple-icons:typescript" slot="icon" />
						</Chip>
						<Chip label="D3.js">
							<Icon name="simple-icons:d3dotjs" slot="icon" />
						</Chip>
					</div>
				</div>
			</section>
		</a>
	</div>

	<style>
		.stack-list {
			display: flex;
			flex-wrap: wrap;
			gap: var(--sub-grid);
		}
		
		.project-list {
			display: flex;
			flex-direction: column;
			gap: 4rem; /* Gap between projects */
			margin-top: 2rem;
		}

		.project-link {
			text-decoration: none;
			color: inherit;
			display: block;
		}

		.project-group {
			display: flex;
			flex-direction: column;
			transition: background-color 0.4s ease;
			padding: 0;
			position: relative;
		}

		/* Hover effect on the whole project group */
		.project-group:hover {
			background-color: rgba(0, 0, 0, 0.02);
		}

		.project-header-block,
		.project-description-block,
		.project-tech-block {
			width: 100% !important;
			padding: 0 1rem;
		}

		.project-header-block {
			gap: 0.5rem;
		}

		.project-title {
			font-size: 2.25rem;
			font-weight: 800;
			letter-spacing: -0.04em;
			margin: 0;
			color: var(--text-color);
			line-height: 1.1;
		}

		.project-name {
			font-size: 0.9rem;
			font-family: 'JetBrains Mono', monospace;
			opacity: 0.5;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			font-weight: 500;
		}

		.project-description {
			font-size: 0.95rem;
			line-height: 1.7;
			color: var(--text-color);
			opacity: 0.7;
			max-width: 36rem;
			margin: 0;
		}

		.project-tech {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
		}
	</style>
</Layout>
