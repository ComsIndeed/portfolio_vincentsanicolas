---
import Layout from '../layouts/Layout.astro';
import BioHeader from '../components/BioHeader.astro';
import ProjectTile, { type TechTag } from '../components/ProjectTile.astro';

interface ProjectItem {
	name: string;
	title: string;
	href: string;
	ariaLabel: string;
	description: string;
	imageSrc: string;
	imageAlt: string;
	transitionName?: string;
	tags: TechTag[];
}

const projects: ProjectItem[] = [
	{
		name: 'LLM_JSON_STREAM (NPM & PUB.DEV)',
		title: 'Open-Source Reactive JSON Stream Parser',
		href: '/llm-json-stream',
		ariaLabel: 'View Project: LLM_JSON_STREAM',
		description:
			'A high-performance incremental JSON stream parsing library published across the TypeScript (NPM) and Dart (pub.dev) ecosystems. Engineered with an event-driven state machine to intercept, buffer, and incrementally parse incomplete, chunked LLM JSON outputs, enabling real-time generative UI assembly and instant data bindings before the stream terminates.',
		imageSrc: '/images/llm-json-stream-placeholder.png',
		imageAlt: 'LLM JSON Stream Parser Schematic',
		transitionName: 'llm-json-stream-image',
		tags: [
			{
				label: 'TypeScript',
				icon: 'simple-icons:typescript',
				href: 'https://www.npmjs.com/package/llm-json-stream',
				linkText: 'Available on NPM'
			},
			{
				label: 'Dart',
				icon: 'simple-icons:dart',
				href: 'https://pub.dev/packages/llm_json_stream',
				linkText: 'Available on pub.dev'
			}
		]
	},
	{
		name: 'LLM_DATA_STREAM_PARSERS (MULTI-LANGUAGE)',
		title: 'Incremental LLM Data Stream Parsers',
		href: '/llm-data-stream-parsers',
		ariaLabel: 'View Project: LLM_DATA_STREAM_PARSERS',
		description:
			'A comprehensive, multi-language streaming parsing engine compiled for Python, TypeScript, Dart, C#, and Kotlin. Specially designed to handle real-time structural analysis of incomplete, tokenized data packets, incrementally yielding valid syntactic sub-trees from raw JSON, YAML, and XML model streams as they are emitted byte-by-byte.',
		imageSrc: '/images/llm-data-stream-parsers-placeholder.png',
		imageAlt: 'LLM Data Stream Parsers Schematic',
		transitionName: 'llm-data-stream-parsers-image',
		tags: [
			{ label: 'Python', icon: 'simple-icons:python' },
			{ label: 'TypeScript', icon: 'simple-icons:typescript' },
			{ label: 'Dart', icon: 'simple-icons:dart' },
			{ label: 'C#', icon: 'simple-icons:csharp' },
			{ label: 'Kotlin', icon: 'simple-icons:kotlin' }
		]
	},
	{
		name: 'PROJECT 2359',
		title: 'AI-Driven Study Application & FSRS Scheduler',
		href: '/project-2359',
		ariaLabel: 'View Project: PROJECT 2359',
		description:
			'A full-stack, AI-augmented educational platform utilizing a custom Free Spaced Repetition Scheduler (FSRS) algorithm and local vector embeddings. Built with Flutter, Supabase, and PostgreSQL, the engine indexes textbook PDFs locally to build context-aware active recall pipelines, automatically generating high-yield study decks and quizzes without data hallucination.',
		imageSrc: '/images/project-2359-placeholder.png',
		imageAlt: 'Project 2359 AI Study & FSRS Scheduler Schematic',
		transitionName: 'project-2359-image',
		tags: [
			{ label: 'Flutter', icon: 'simple-icons:flutter' },
			{ label: 'Supabase', icon: 'simple-icons:supabase' }
		]
	},
	{
		name: 'PROJECT 2360 (FLOWSERRACT)',
		title: 'AI-Driven Zero-Compile Runtime Native App Engine',
		href: '/project-2360',
		ariaLabel: 'View Project: PROJECT 2360',
		description:
			'An experimental dynamic canvas framework that compiles natural language prompts into fully functional native applications at runtime, bypassing traditional compilation steps. Engineered complete with an on-the-fly local database, reactive state management, runtime scripting execution, dynamic native layouts, and an integrated AI architect capable of designing, building, and running the entire system interactively.',
		imageSrc: '/images/project-2360-placeholder.png',
		imageAlt: 'Flowserract Generative Native UI Engine Schematic',
		transitionName: 'project-2360-image',
		tags: [
			{ label: 'Flutter', icon: 'simple-icons:flutter' },
			{ label: 'Supabase', icon: 'simple-icons:supabase' },
			{ label: 'Dart', icon: 'simple-icons:dart' }
		]
	},
	{
		name: 'STREAMING_GEN_UI (FLUTTER)',
		title: 'Real-Time Generative User Interface Rendering & Processing Engine',
		href: '/streaming-gen-ui',
		ariaLabel: 'View Project: STREAMING_GEN_UI',
		description:
			'A highly modular, event-driven generative UI layout engine for Flutter applications. Designed to decouple AI transport layers from front-end widget trees, it handles namespaced token streams, compiles partial JSON component schemas via reactive builders, manages multi-view target-routing tags, and dynamically activates passive inputs as streams finalize.',
		imageSrc: '/images/streaming-gen-ui-placeholder.png',
		imageAlt: 'Streaming Gen UI Controller Schematic',
		transitionName: 'streaming-gen-ui-image',
		tags: [
			{ label: 'Flutter', icon: 'simple-icons:flutter' },
			{ label: 'Dart', icon: 'simple-icons:dart' }
		]
	}
];
---

<Layout title="Vincent Sanicolas | Portfolio">
	<!-- Bio Summary, Social links, & Tech Stack Unified Bio Block -->
	<BioHeader />

	<!-- Visual Spacer aligning to grid Snapping -->
	<div data-snap="block" class="spacer-block" />
	
	<div data-snap="block" class="show-snap">
		<h2>Projects</h2>
	</div>

	<div class="project-list">
		{projects.map((project) => (
			<ProjectTile {...project} />
		))}
	</div>

	<style>
		.project-list {
			display: flex;
			flex-direction: column;
			gap: var(--grid-size); /* Gap between projects */
			margin-top: var(--grid-size);
		}

		.spacer-block {
			height: 2rem;
		}
	</style>
</Layout>
