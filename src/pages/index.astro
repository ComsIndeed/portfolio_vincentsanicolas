---
import Layout from '../layouts/Layout.astro';
import Chip from '../components/Chip.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Vincent Sanicolas | Portfolio">
	<div data-snap="block" class="show-snap">
		<h1>Vincent Sanicolas</h1>
	</div>

	<div data-snap="block" class="show-snap">
		<p>
			Software Developer | Flutter & Web
			<br/>
			Metro Manila, Philippines
		</p>
	</div>

	<div data-snap="block" class="show-snap">
		<div class="stack-list">
			<Chip label="Flutter">
				<Icon name="simple-icons:flutter" slot="icon" />
			</Chip>
			<Chip label="Dart">
				<Icon name="simple-icons:dart" slot="icon" />
			</Chip>
			<Chip label="React">
				<Icon name="simple-icons:react" slot="icon" />
			</Chip>
			<Chip label="TypeScript">
				<Icon name="simple-icons:typescript" slot="icon" />
			</Chip>
			<Chip label="Astro">
				<Icon name="simple-icons:astro" slot="icon" />
			</Chip>
			<Chip label="Supabase">
				<Icon name="simple-icons:supabase" slot="icon" />
			</Chip>
		</div>
	</div>

	<style>
		.stack-list {
			display: flex;
			flex-wrap: wrap;
			gap: var(--sub-grid);
		}
		
		ul {
			list-style: none;
		}

		.project-item {
			display: block;
		}
	</style>
	
	<div data-snap="block" class="show-snap">
		<h2>Projects</h2>
	</div>

	<ul>
		<li data-snap="block" class="show-snap project-item">
			<a href="/llm-json-stream">LLM JSON Stream</a>
		</li>
		<li data-snap="block" class="show-snap project-item">
			<a href="/project-2359">Project 2359</a>
		</li>
		<li data-snap="block" class="show-snap project-item">
			<a href="/project-2360">Project 2360</a>
		</li>
	</ul>
</Layout>
