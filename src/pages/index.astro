---
import Layout from '../layouts/Layout.astro';
import BioHeader from '../components/BioHeader.astro';
import Chip from '../components/chip.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Vincent Sanicolas | Portfolio">
	<!-- Bio Summary, Social links, & Tech Stack Unified Bio Block -->
	<BioHeader />

	<!-- Visual Spacer aligning to grid Snapping -->
	<div data-snap="block" class="spacer-block" />
	
	<div data-snap="block" class="show-snap">
		<h2>Projects</h2>
	</div>

	<div class="project-list">
		<!-- Project 1 -->
		<section class="project-group">
			<a href="/llm-json-stream" class="project-tile-link" aria-label="View Project: LLM_JSON_STREAM"></a>
			
			<div class="project-text-side">
				<div data-snap="block" class="show-snap project-header-block">
					<span class="project-name">LLM_JSON_STREAM (NPM & PUB.DEV)</span>
					<h3 class="project-title">Open-Source Reactive JSON Stream Parser</h3>
				</div>
				
				<div data-snap="block" class="show-snap project-description-block">
					<p class="project-description">
						A high-performance package published for both the TypeScript and Dart ecosystems. Designed to handle, parse, and reactively yield complex JSON data streams from large language models in real-time, enabling seamless generative UI implementations.
					</p>
				</div>
				
				<div data-snap="block" class="show-snap project-tech-block">
					<div class="project-tech">
						<Chip 
							label="TypeScript" 
							href="https://www.npmjs.com/package/llm-json-stream" 
							linkText="Available on NPM"
						>
							<Icon name="simple-icons:typescript" slot="icon" />
						</Chip>
						<Chip 
							label="Dart" 
							href="https://pub.dev/packages/llm_json_stream" 
							linkText="Available on pub.dev"
						>
							<Icon name="simple-icons:dart" slot="icon" />
						</Chip>
					</div>
				</div>
			</div>

			<div data-snap="block" class="show-snap project-image-block">
				<div class="project-image-container">
					<img src="/images/llm-json-stream-placeholder.png" alt="LLM JSON Stream Parser Schematic" class="project-image" transition:name="llm-json-stream-image" />
				</div>
			</div>
		</section>

		<!-- Project 2 -->
		<section class="project-group">
			<a href="/project-2359" class="project-tile-link" aria-label="View Project: PROJECT 2359"></a>
			
			<div class="project-text-side">
				<div data-snap="block" class="show-snap project-header-block">
					<span class="project-name">PROJECT 2359</span>
					<h3 class="project-title">AI-Driven Study Application & FSRS Scheduler</h3>
				</div>
				
				<div data-snap="block" class="show-snap project-description-block">
					<p class="project-description">
						A comprehensive full-stack student platform integrating a Free Spaced Repetition Scheduler (FSRS), local PDF indexing, and dynamic AI-driven study material generation. Engineered with a strict focus on scalable architecture and a fluid, frictionless aesthetic experience.
					</p>
				</div>
				
				<div data-snap="block" class="show-snap project-tech-block">
					<div class="project-tech">
						<Chip label="Flutter">
							<Icon name="simple-icons:flutter" slot="icon" />
						</Chip>
						<Chip label="Supabase">
							<Icon name="simple-icons:supabase" slot="icon" />
						</Chip>
					</div>
				</div>
			</div>

			<div data-snap="block" class="show-snap project-image-block">
				<div class="project-image-container">
					<img src="/images/project-2359-placeholder.png" alt="Project 2359 AI Study & FSRS Scheduler Schematic" class="project-image" transition:name="project-2359-image" />
				</div>
			</div>
		</section>

		<!-- Project 3 -->
		<section class="project-group">
			<a href="/project-2360" class="project-tile-link" aria-label="View Project: PROJECT 2360"></a>
			
			<div class="project-text-side">
				<div data-snap="block" class="show-snap project-header-block">
					<span class="project-name">PROJECT 2360 (FLOWSERRACT)</span>
					<h3 class="project-title">Generative Native UI Engine</h3>
				</div>
				
				<div data-snap="block" class="show-snap project-description-block">
					<p class="project-description">
						An experimental architectural framework that parses natural language prompts to dynamically assemble and render native application widgets in real-time. Leverages the `llm_json_stream` parser to handle streaming data and bridge the gap between AI logic and low-level component rendering.
					</p>
				</div>
				
				<div data-snap="block" class="show-snap project-tech-block">
					<div class="project-tech">
						<Chip label="Flutter">
							<Icon name="simple-icons:flutter" slot="icon" />
						</Chip>
						<Chip label="Supabase">
							<Icon name="simple-icons:supabase" slot="icon" />
						</Chip>
						<Chip label="Dart">
							<Icon name="simple-icons:dart" slot="icon" />
						</Chip>
					</div>
				</div>
			</div>

			<div data-snap="block" class="show-snap project-image-block">
				<div class="project-image-container">
					<img src="/images/project-2360-placeholder.png" alt="Flowserract Generative Native UI Engine Schematic" class="project-image" transition:name="project-2360-image" />
				</div>
			</div>
		</section>
	</div>

	<style>
		.project-list {
			display: flex;
			flex-direction: column;
			gap: 4rem; /* Gap between projects */
			margin-top: 2rem;
		}

		.project-link {
			text-decoration: none;
			color: inherit;
			display: block;
		}

		.project-group {
			display: grid;
			grid-template-columns: 1.2fr 1fr; /* Wider images, giving more balanced proportions */
			gap: var(--grid-size);
			padding: 0;
			position: relative;
			transition: 
				background-color 200ms var(--ease-out-expo),
				transform 150ms var(--ease-out-expo);
		}

		.project-text-side {
			display: flex;
			flex-direction: column;
			width: 100%;
			justify-content: center; /* Vertically centers the text block relative to the image */
		}

		.project-image-block {
			width: 100% !important;
			display: flex;
			align-items: center; /* Centers the 4:3 block vertically */
		}

		.project-image-container {
			width: 100%;
			aspect-ratio: 4 / 3; /* Perfect 4:3 ratio */
			background: rgba(0, 0, 0, 0.015);
			border: 1px dashed rgba(0, 0, 0, 0.1);
			display: flex;
			align-items: center;
			justify-content: center;
			overflow: hidden;
			position: relative;
			transition: border-color 150ms var(--ease-out-expo), background-color 150ms var(--ease-out-expo);
		}

		.project-group:hover .project-image-container {
			border-color: rgba(0, 0, 0, 0.25);
			background-color: rgba(0, 0, 0, 0.03);
		}

		.project-image {
			width: 100%;
			height: 100%;
			object-fit: cover;
			opacity: 0.85;
			mix-blend-mode: multiply; /* Perfect for off-white images to blend in */
			transition: opacity 150ms var(--ease-out-expo), transform 150ms var(--ease-out-expo);
		}

		.project-group:hover .project-image {
			opacity: 1;
			transform: scale(1.02);
		}

		.project-title-link {
			text-decoration: none;
			color: inherit;
			display: inline-block;
			width: fit-content;
		}

		/* Hover effect on the whole project group */
		.project-group:hover {
			background-color: rgba(0, 0, 0, 0.02);
		}

		.project-group:active {
			transform: scale(0.995);
		}

		.project-group:hover .project-title {
			text-decoration: underline;
			text-underline-offset: 4px;
			text-decoration-thickness: 2px;
		}

		.project-tile-link {
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			z-index: 10;
		}

		.project-tech-block {
			position: relative;
			z-index: 20;
			pointer-events: none; /* Allow clicks to pass through to the tile link */
		}

		.project-tech-block :global(a) {
			pointer-events: auto; /* Re-enable clicks for chips with links */
		}

		.project-header-block,
		.project-description-block,
		.project-tech-block {
			width: 100% !important;
			padding: 0;
		}

		.project-header-block {
			gap: 0.5rem;
		}

		.project-title {
			font-size: 1.85rem; /* Slightly smaller than h1 */
			font-weight: 600; /* Less bold, matching global headings */
			letter-spacing: -0.02em;
			margin: 0;
			color: var(--text-color);
			line-height: 1.1;
		}

		.project-name {
			font-size: 0.9rem;
			font-family: 'JetBrains Mono', monospace;
			opacity: 0.5;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			font-weight: 500;
		}

		.project-description {
			font-size: 0.95rem;
			line-height: 1.7;
			color: var(--text-color);
			opacity: 0.7;
			max-width: 36rem;
			margin: 0;
			text-align: justify;
		}

		.project-tech {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
		}

		.spacer-block {
			height: 2rem;
		}

		@media (max-width: 768px) {
			.project-group {
				grid-template-columns: 1fr;
				row-gap: 1.5rem;
				column-gap: 0;
			}

			.project-text-side {
				display: contents !important; /* Wrapper collapses, children become direct grid items */
			}

			.project-header-block {
				order: 1 !important;
			}

			.project-image-block {
				order: 2 !important; /* Graphic sits perfectly inline between header tagline and paragraph! */
			}

			.project-description-block {
				order: 3 !important;
			}

			.project-tech-block {
				order: 4 !important;
			}
		}
	</style>
</Layout>
