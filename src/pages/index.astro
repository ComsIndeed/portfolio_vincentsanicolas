---
import Layout from '../layouts/Layout.astro';
import Chip from '../components/chip.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Vincent Sanicolas | Portfolio">
	<div data-snap="block" class="show-snap">
		<h1>Vincent Sanicolas</h1>
	</div>

	<div data-snap="block" class="show-snap">
		<p>
			Software Developer | Flutter & Web
			<br/>
			Metro Manila, Philippines
		</p>
	</div>

	<div data-snap="block" class="show-snap">
		<div class="stack-list">
			<Chip label="Flutter">
				<Icon name="simple-icons:flutter" slot="icon" />
			</Chip>
			<Chip label="Dart">
				<Icon name="simple-icons:dart" slot="icon" />
			</Chip>
			<Chip label="React">
				<Icon name="simple-icons:react" slot="icon" />
			</Chip>
			<Chip label="TypeScript">
				<Icon name="simple-icons:typescript" slot="icon" />
			</Chip>
			<Chip label="Astro">
				<Icon name="simple-icons:astro" slot="icon" />
			</Chip>
			<Chip label="Supabase">
				<Icon name="simple-icons:supabase" slot="icon" />
			</Chip>
		</div>
	</div>
	</div>

	<div data-snap="block" class="show-snap">
		<h2>Projects</h2>
	</div>

	<div class="project-list">
		<!-- Project 1 -->
		<section class="project-group">
			<a href="/llm-json-stream" class="project-tile-link" aria-label="View Project: LLM_JSON_STREAM"></a>
			<div data-snap="block" class="show-snap project-header-block">
				<span class="project-name">LLM_JSON_STREAM (NPM & PUB.DEV)</span>
				<h3 class="project-title">Open-Source Reactive JSON Stream Parser</h3>
			</div>
			<div data-snap="block" class="show-snap project-description-block">
				<p class="project-description">
					A high-performance package published for both the TypeScript and Dart ecosystems. Designed to handle, parse, and reactively yield complex JSON data streams from large language models in real-time, enabling seamless generative UI implementations.
				</p>
			</div>
			<div data-snap="block" class="show-snap project-tech-block">
				<div class="project-tech">
					<Chip 
						label="TypeScript" 
						href="https://www.npmjs.com/package/llm-json-stream" 
						linkText="Available on NPM"
					>
						<Icon name="simple-icons:typescript" slot="icon" />
					</Chip>
					<Chip 
						label="Dart" 
						href="https://pub.dev/packages/llm_json_stream" 
						linkText="Available on pub.dev"
					>
						<Icon name="simple-icons:dart" slot="icon" />
					</Chip>
				</div>
			</div>
		</section>

		<!-- Project 2 -->
		<section class="project-group">
			<a href="/project-2359" class="project-tile-link" aria-label="View Project: PROJECT 2359"></a>
			<div data-snap="block" class="show-snap project-header-block">
				<span class="project-name">PROJECT 2359</span>
				<h3 class="project-title">AI-Driven Study Application & FSRS Scheduler</h3>
			</div>
			<div data-snap="block" class="show-snap project-description-block">
				<p class="project-description">
					A comprehensive full-stack student platform integrating a Free Spaced Repetition Scheduler (FSRS), local PDF indexing, and dynamic AI-driven study material generation. Engineered with a strict focus on scalable architecture and a fluid, frictionless aesthetic experience.
				</p>
			</div>
			<div data-snap="block" class="show-snap project-tech-block">
				<div class="project-tech">
					<Chip label="Flutter">
						<Icon name="simple-icons:flutter" slot="icon" />
					</Chip>
					<Chip label="Supabase">
						<Icon name="simple-icons:supabase" slot="icon" />
					</Chip>
				</div>
			</div>
		</section>

		<!-- Project 3 -->
		<section class="project-group">
			<a href="/project-2360" class="project-tile-link" aria-label="View Project: PROJECT 2360"></a>
			<div data-snap="block" class="show-snap project-header-block">
				<span class="project-name">PROJECT 2360 (FLOWSERRACT)</span>
				<h3 class="project-title">Generative Native UI Engine</h3>
			</div>
			<div data-snap="block" class="show-snap project-description-block">
				<p class="project-description">
					An experimental architectural framework that parses natural language prompts to dynamically assemble and render native application widgets in real-time. Leverages the `llm_json_stream` parser to handle streaming data and bridge the gap between AI logic and low-level component rendering.
				</p>
			</div>
			<div data-snap="block" class="show-snap project-tech-block">
				<div class="project-tech">
					<Chip label="Flutter">
						<Icon name="simple-icons:flutter" slot="icon" />
					</Chip>
					<Chip label="Supabase">
						<Icon name="simple-icons:supabase" slot="icon" />
					</Chip>
					<Chip label="Dart">
						<Icon name="simple-icons:dart" slot="icon" />
					</Chip>
				</div>
			</div>
		</section>
	</div>

	<style>
		.stack-list {
			display: flex;
			flex-wrap: wrap;
			gap: var(--sub-grid);
		}
		
		.project-list {
			display: flex;
			flex-direction: column;
			gap: 4rem; /* Gap between projects */
			margin-top: 2rem;
		}

		.project-link {
			text-decoration: none;
			color: inherit;
			display: block;
		}

		.project-group {
			display: flex;
			flex-direction: column;
			padding: 0;
			position: relative;
			transition: 
				background-color 200ms var(--ease-out-expo),
				transform 150ms var(--ease-out-expo);
		}

		.project-title-link {
			text-decoration: none;
			color: inherit;
			display: inline-block;
			width: fit-content;
		}

		/* Hover effect on the whole project group */
		.project-group:hover {
			background-color: rgba(0, 0, 0, 0.02);
		}

		.project-group:active {
			transform: scale(0.995);
		}

		.project-group:hover .project-title {
			text-decoration: underline;
			text-underline-offset: 4px;
			text-decoration-thickness: 2px;
		}

		.project-tile-link {
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			z-index: 10;
		}

		.project-tech-block {
			position: relative;
			z-index: 20;
			pointer-events: none; /* Allow clicks to pass through to the tile link */
		}

		.project-tech-block :global(a) {
			pointer-events: auto; /* Re-enable clicks for chips with links */
		}

		.project-header-block,
		.project-description-block,
		.project-tech-block {
			width: 100% !important;
			padding: 0 1rem;
		}

		.project-header-block {
			gap: 0.5rem;
		}

		.project-title {
			font-size: 1.85rem; /* Slightly smaller than h1 */
			font-weight: 600; /* Less bold, matching global headings */
			letter-spacing: -0.02em;
			margin: 0;
			color: var(--text-color);
			line-height: 1.1;
		}

		h1 {
			font-size: 2.25rem;
			font-weight: 700;
			letter-spacing: -0.04em;
		}

		.project-name {
			font-size: 0.9rem;
			font-family: 'JetBrains Mono', monospace;
			opacity: 0.5;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			font-weight: 500;
		}

		.project-description {
			font-size: 0.95rem;
			line-height: 1.7;
			color: var(--text-color);
			opacity: 0.7;
			max-width: 36rem;
			margin: 0;
		}

		.project-tech {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
		}
	</style>
</Layout>
