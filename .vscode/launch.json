{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Astro: Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:host",
      ],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "debugWithChrome",
        "pattern": "(?:Local|local):?\\s+(https?://\\S+)",
        "enabled": false
      }
    }
  ]
}